# Copy to .env and fill in for a real SAP system. Leave SAP_MOCK_MODE=true
# to run the whole pipeline against the sample data in examples/ instead.
SAP_MOCK_MODE=true

SAP_ASHOST=ides.example.com
SAP_SYSNR=00
SAP_CLIENT=800
SAP_USER=your-rfc-user
SAP_PASSWD=your-password
SAP_LANG=EN

# MariaDB
MARIADB_URL=mysql+pymysql://sap:sap@localhost:3306/sap_middleware

# PostgreSQL
POSTGRES_URL=postgresql+psycopg2://sap:sap@localhost:5432/sap_middleware
